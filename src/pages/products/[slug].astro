---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {money} from '../../lib/catalogue';
export async function getStaticPaths(){const mod=await import('../../data/products.json');return mod.default.map(product=>({params:{slug:product.slug},props:{product}}))} const {product}=Astro.props; const first=product.variants[0];
const schema={"@context":"https://schema.org","@type":"Product",name:product.name,image:product.images.map(i=>new URL(i.local,Astro.site).href),description:product.seo.description,sku:first.sku||undefined,offers:{"@type":"AggregateOffer",priceCurrency:'MAD',lowPrice:Math.min(...product.variants.map(v=>v.price)),highPrice:Math.max(...product.variants.map(v=>v.price)),availability:product.available?'https://schema.org/InStock':'https://schema.org/OutOfStock'}};
---
<BaseLayout title={`${product.name} – Nature & Passions`} description={product.seo.description} image={product.images[0]?.local}><script type="application/ld+json" set:html={JSON.stringify(schema)}/><section class="product-page"><div class="gallery"><div class="gallery-main">{product.images[0]&&<img id="main-image" src={product.images[0].local} alt={product.images[0].alt}>}</div><div class="thumbs">{product.images.map(i=><button data-image={i.local}><img src={i.local} alt={i.alt}></button>)}</div></div><div class="product-info"><p class="eyebrow">Nature & Passions</p><h1>{product.name}</h1><p id="product-price" class="product-price">{money(first.price)}</p>{product.variants.length>1&&<label>Format<select id="variant">{product.variants.map(v=><option value={v.id} data-price={v.price} data-title={v.title} disabled={!v.available}>{v.title} — {money(v.price)}</option>)}</select></label>}<label>Quantité<div class="quantity"><button type="button" data-dec>−</button><input id="quantity" type="number" min="1" value="1"><button type="button" data-inc>+</button></div></label><button id="add-cart" class="button" disabled={!product.available}>{product.available?'Ajouter au panier':'Épuisé'}</button><div class="description" set:html={product.descriptionHtml}/></div></section><script define:vars={{product}} is:inline>const sel=document.querySelector('#variant'),qty=document.querySelector('#quantity');sel?.addEventListener('change',()=>document.querySelector('#product-price').textContent=`Dh ${Number(sel.selectedOptions[0].dataset.price).toFixed(2)} MAD`);document.querySelector('[data-dec]').onclick=()=>qty.value=Math.max(1,+qty.value-1);document.querySelector('[data-inc]').onclick=()=>qty.value=+qty.value+1;document.querySelectorAll('[data-image]').forEach(b=>b.onclick=()=>document.querySelector('#main-image').src=b.dataset.image);document.querySelector('#add-cart')?.addEventListener('click',()=>{const v=product.variants.find(v=>v.id===(sel?.value||product.variants[0].id));window.NPCart.add({productId:product.id,variantId:v.id,name:product.name,variant:v.title,price:v.price,image:product.images[0]?.local,quantity:+qty.value})});</script></BaseLayout>
