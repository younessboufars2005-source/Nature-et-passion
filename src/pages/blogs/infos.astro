---
import BaseLayout from '../../layouts/BaseLayout.astro';
const articles=[['la-propolis-proprietes-bienfaits','La Propolis – Propriétés & Bienfaits'],['le-pollen-proprietes-bienfaits','Le Pollen – Propriétés & Bienfaits'],['le-safran-de-taliouine-proprietes-bienfaits','Le Safran de Taliouine – Propriétés & Bienfaits'],['la-gelee-royale-proprietes-bienfaits','La Gelée royale – Propriétés & Bienfaits'],['le-miel-proprietes-bienfaits','Le Miel – Propriétés & Bienfaits'],['le-miel-vertus-therapeutiques','Le Miel – Vertus thérapeutiques'],['le-miel-nutriments-naturel-vs-nutriments-synthetiques','Le Miel – Nutriments naturel Vs Nutriments synthétiques'],['phytotherapie-apitherapie','Phytothérapie – Apithérapie ( soin par le miel ) – Histoire & Origine']];
---
<BaseLayout title="Blogs – Nature & Passions"><section><h1>Blogs</h1><div class="blog-list">{articles.map(([slug,title])=><article><h2><a href={`/blogs/infos/${slug}`}>{title}</a></h2></article>)}</div></section></BaseLayout><style>.blog-list{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.blog-list article{background:#f3f3f3;padding:30px}.blog-list h2{font-weight:400}@media(max-width:600px){.blog-list{grid-template-columns:1fr}}</style>
